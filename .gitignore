# dependencies
node_modules/
**/node_modules/

# build output
dist/
/build/*
# ...but keep the committed app-icon assets (electron-builder buildResources)
!/build/icon.png
!/build/icon.icns
release/
server/dist/
client/dist/

# live database + dev data (never commit the DB or backups)
.data/
*.db
*.db-wal
*.db-shm

# generated demo database — the fixtures live in server/src/demo.ts, this is
# just its output. Rebuild with `npm run demo:seed`.
.demo/

# the Notion importer — a one-off onboarding tool, kept locally but not published. It
# documents a third party's internal template, which is theirs rather than ours. Run it
# with:
#   cd server && npx tsx src/notion/import.ts <export-dir> [ziel-verzeichnis]
/server/src/notion/

# output of the Notion importer — season databases built from a user's Notion export,
# so they hold the same real names, addresses and notes that `files/` does. Globbed: one
# output directory per season (.notion-import, .notion-import-2027, …).
.notion-import*/

# real import data: the CSVs hold real names, e-mail addresses and internal
# notes. Stays local — seed.ts falls back to sample data when absent.
/files/

# the 2026-07 code review: findings, the 15 work packages, and the 81 verification scripts
# they were checked with. Closed 2026-08-04 — nothing in it is an unfixed vulnerability and it
# holds no personal data. It stays local because it is a historical record of defects that are
# fixed, and the commit log is the better index of those: `git log --grep=CCL-24`. What was
# worth keeping lives in docs/ARCHITECTURE.md, docs/DECISIONS.md and docs/VERIFYING.md.
# Ignored rather than merely untracked so a stray `git add -A` cannot sweep it in.
/review/

# secrets. None of these exist yet — the app has no API keys and CI uses only the
# implicit GITHUB_TOKEN — but code signing is the known next step (docs/DECISIONS.md),
# and a certificate is exactly the kind of file that arrives in a hurry. On a public
# repo the ignore rule has to predate the file, not follow it.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.cer
*.mobileprovision
# Ignored everywhere, because an `.npmrc` is where a registry auth token ends up. The one
# exception is the repository root, which is committed and holds a single line —
# `engine-strict=true`. The negation is anchored with a leading slash so it applies to that
# file alone: an `.npmrc` appearing in server/ or client/ is still ignored.
.npmrc
!/.npmrc

# logs / os
*.log
.DS_Store

# electron
out/

