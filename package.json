{
  "name": "auftakt",
  "private": true,
  "version": "0.9.0",
  "description": "Auftakt — Künstler- und Projektverwaltung für ein klassisches Musikfestival",
  "author": "Andre Wendlinger",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/andrewendlinger/auftakt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewendlinger/auftakt.git"
  },
  "bugs": {
    "url": "https://github.com/andrewendlinger/auftakt/issues"
  },
  "main": "electron/dist/main.cjs",
  "engines": {
    "node": "^24",
    "npm": ">=11.17"
  },
  "scripts": {
    "setup": "npm install && npm --prefix server install && npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "dev": "concurrently -k -n server,client -c blue,green \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "npm --prefix server run demo",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck && tsc -p electron/tsconfig.json && tsc -p tsconfig.scripts.json",
    "check": "npm run check:unit && npm run check:backup && npm run check:dates && npm run check:api && npm run check:markdown",
    "check:unit": "npm --prefix client run test",
    "check:backup": "node scripts/check-backup.mjs",
    "check:dates": "node scripts/check-dates.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:markdown": "npm --prefix client run check:markdown",
    "check:package": "node scripts/check-package.mjs",
    "icons": "node scripts/icons.mjs",
    "build:client": "npm --prefix client run build",
    "build:bundles": "node scripts/build.mjs",
    "build": "npm run build:client && npm run build:bundles",
    "electron:dev": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
